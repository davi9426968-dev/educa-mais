# Conexão com o PostgreSQL (deve bater com docker-compose.yml na raiz do projeto)
DATABASE_URL="postgresql://educa:educa123@localhost:5432/educa_mais?schema=public"

# Segredo usado para assinar os tokens JWT. Troque por uma string aleatória longa em produção.
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-e-secreta"
JWT_EXPIRES_IN="7d"

# Porta em que a API vai rodar
PORT=3333

# Origem permitida para requisições CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5173"

# Pasta local onde arquivos enviados (materiais, imagens de dúvidas) serão salvos em desenvolvimento
UPLOADS_DIR="uploads"
